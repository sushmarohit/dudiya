DATABASE_URL="postgresql://milk:milk@localhost:5435/milk?schema=public"
JWT_SECRET="change-me-access-secret"
JWT_REFRESH_SECRET="change-me-refresh-secret"
PORT=3001
FRONTEND_URL=http://localhost:3000
GOOGLE_MAPS_API_KEY=

# SMTP (required for forgot-password + customer activation emails)
# Example: Mailtrap, Gmail app password, Amazon SES, etc.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false
SMTP_FROM="Dudiya <noreply@yourdomain.com>"

# Feature flags (set to "true" to re-enable)
# Subscription flow: customer/distributor create new milk delivery subscriptions
FEATURE_SUBSCRIPTION_FLOW_ENABLED=false
# Customer self-subscribe requires distributor accept/decline
FEATURE_SUBSCRIPTION_APPROVAL_ENABLED=false
# Billing: invoices, payment recording, and automated billing cron jobs
FEATURE_BILLING_ENABLED=false

# Optional: set GOOGLE_MAPS_API_KEY for accurate geocoding in production.
# Without it, OpenStreetMap Nominatim is used, then mock hash fallback.
